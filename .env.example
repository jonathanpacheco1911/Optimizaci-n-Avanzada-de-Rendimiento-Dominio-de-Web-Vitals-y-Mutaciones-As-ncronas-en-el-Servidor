# URL base de la API REST (Laravel). Incluye el prefijo /api y NO termines con "/".
# Solo se usa en el servidor (Server Components, Server Actions y Route Handlers).
BASE_URL=http://localhost:8000/api

# Llave publicable de Stripe (modo test), la misma cuenta que usa la API.
# Es la única variable expuesta al navegador (la necesita Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
